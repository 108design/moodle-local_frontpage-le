<figure id="{{id}}" class="local-frontpage-segment local-frontpage-media local-frontpage-media-aspect-{{aspect}} local-frontpage-media-fit-{{fit}} local-frontpage-media-focal-{{focal}}"{{#presentationstyle}} style="{{presentationstyle}}"{{/presentationstyle}}>
    <span class="local-frontpage-media-frame">
        <img src="{{src}}" alt="{{alt}}" loading="{{loading}}"{{#decorative}} role="presentation"{{/decorative}}>
    </span>
    {{#caption}}<figcaption class="local-frontpage-media-caption">{{caption}}</figcaption>{{/caption}}
</figure>
