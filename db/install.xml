<?xml version="1.0" encoding="UTF-8"?>
<XMLDB PATH="local/frontpage/db" VERSION="2026010100" COMMENT="Frontpage pages, revisions and course resources"><TABLES>
<TABLE NAME="local_frontpage_page" COMMENT="Frontpage page metadata and revision pointers">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ownercomponent" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="local_frontpage"/>
        <FIELD NAME="ownerinstanceid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="bindingtype" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="system"/>
        <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="showincheckout" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="requireconfirmation" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sitehomescope" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="layergroupid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="slug" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="shell" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="moodle"/>
        <FIELD NAME="showtopnav" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="showdrawer" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="showpageindex" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="showfooter" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="usecontentcontainer" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="contentwidth" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="wide"/>
        <FIELD NAME="contentwidthvalue" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="visibility" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="private"/>
        <FIELD NAME="accessjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="navplacement" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none"/>
        <FIELD NAME="menuicon" TYPE="char" LENGTH="100" NOTNULL="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="draftrevisionid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="publishedrevisionid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="modifiedby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="slug_uix" UNIQUE="true" FIELDS="slug"/>
        <INDEX NAME="status_ix" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="owner_ix" UNIQUE="false" FIELDS="ownercomponent,ownerinstanceid"/>
        <INDEX NAME="context_ix" UNIQUE="false" FIELDS="contextid"/>
        <INDEX NAME="binding_ix" UNIQUE="false" FIELDS="bindingtype,targetid"/>
        <INDEX NAME="group_ix" UNIQUE="false" FIELDS="groupid"/>
      </INDEXES>
    </TABLE>
<TABLE NAME="local_frontpage_revision" COMMENT="Current drafts, immutable publications and draft checkpoints">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="revisionnumber" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="schemaversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="2"/>
        <FIELD NAME="documentjson" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="summary" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="draftversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="publishedby" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timepublished" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="ischeckpoint" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="originjson" TYPE="text" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="page_fk" TYPE="foreign" FIELDS="pageid" REFTABLE="local_frontpage_page" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="page_revision_uix" UNIQUE="true" FIELDS="pageid, revisionnumber"/>
        <INDEX NAME="page_published_ix" UNIQUE="false" FIELDS="pageid,timepublished"/>
        <INDEX NAME="page_checkpoint_ix" UNIQUE="false" FIELDS="pageid,ischeckpoint"/>
      </INDEXES>
    </TABLE>
<TABLE NAME="local_frontpage_resource" COMMENT="Ownership and lifecycle registry for Moodle modules associated with course Frontpages">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sectionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="origin" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="adopted"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="active"/>
        <FIELD NAME="sourcepageid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="orphanedsince" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="cmid_uix" UNIQUE="true" FIELDS="cmid"/>
        <INDEX NAME="course_status_ix" UNIQUE="false" FIELDS="courseid,status"/>
        <INDEX NAME="section_ix" UNIQUE="false" FIELDS="sectionid"/>
        <INDEX NAME="sourcepage_ix" UNIQUE="false" FIELDS="sourcepageid"/>
        <INDEX NAME="orphaned_ix" UNIQUE="false" FIELDS="orphanedsince"/>
      </INDEXES>
    </TABLE>
<TABLE NAME="local_frontpage_cmref" COMMENT="Revision-level index of Frontpage course-module references">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="revisionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="segmentid" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="revision_fk" TYPE="foreign" FIELDS="revisionid" REFTABLE="local_frontpage_revision" REFFIELDS="id"/>
        <KEY NAME="page_fk" TYPE="foreign" FIELDS="pageid" REFTABLE="local_frontpage_page" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="revision_segment_uix" UNIQUE="true" FIELDS="revisionid,segmentid"/>
        <INDEX NAME="cmid_ix" UNIQUE="false" FIELDS="cmid"/>
      </INDEXES>
    </TABLE>
</TABLES></XMLDB>
